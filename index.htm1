<!DOCTYPE html>
<html>
<head>
    <title>طلب إذن الكاميرا التعليمي</title>
</head>
<body>
    <h2>مثال تعليمي للوصول إلى الكاميرا</h2>
    <!-- زر يضغط عليه المستخدم لتفعيل الكاميرا بشكل علني -->
    <button onclick="startCamera()">تشغيل الكاميرا</button>
    <video id="video" width="400" height="300" autoplay></video>

    <script>
    async function startCamera() {
        try {
            // المتصفح يجبر الموقع على إظهار رسالة طلب إذن للمستخدم
            const stream = await navigator.mediaDevices.getUserMedia({ video: true });
            const videoElement = document.getElementById('video');
            videoElement.srcObject = stream;
        } catch (error) {
            console.error("تم رفض الإذن أو حدث خطأ:", error);
        }
    }
    </script>
</body>
</html>
يُرجى استخدا
